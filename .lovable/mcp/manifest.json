{
  "version": 1,
  "sdk_version": "0.20.1",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://xbyewjvfrshemjvtgacz.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "marmoreproart-mcp",
      "version": "0.1.0",
      "title": "MármoreProart"
    },
    "tools": [
      {
        "name": "list_projects",
        "title": "Listar projetos",
        "description": "Lista os projetos de marmoraria do usuário autenticado (mais recentes primeiro).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20,
              "description": "Máximo de projetos a retornar."
            },
            "status": {
              "type": "string",
              "description": "Filtrar por status (opcional)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_clients",
        "title": "Listar clientes",
        "description": "Lista os clientes cadastrados do usuário autenticado, com busca opcional por nome.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "search": {
              "type": "string",
              "description": "Texto para buscar no nome do cliente."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_quotes",
        "title": "Listar orçamentos",
        "description": "Lista os orçamentos do usuário autenticado (mais recentes primeiro).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            },
            "client_id": {
              "type": "string",
              "format": "uuid",
              "description": "Filtrar por cliente."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_stones",
        "title": "Listar pedras do mostruário",
        "description": "Lista as pedras (mármores, quartzos, quartzitos) visíveis para o usuário autenticado.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "search": {
              "type": "string",
              "description": "Buscar por nome da pedra."
            },
            "category": {
              "type": "string",
              "description": "Categoria (marmore, quartzo, quartzito, etc)."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 30
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "create_client",
        "title": "Criar cliente",
        "description": "Cadastra um novo cliente para o usuário autenticado.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "description": "Nome completo do cliente."
            },
            "email": {
              "type": "string",
              "format": "email"
            },
            "phone": {
              "type": "string",
              "description": "Telefone (com DDD)."
            },
            "address": {
              "type": "string"
            },
            "notes": {
              "type": "string"
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "create_quote",
        "title": "Criar orçamento",
        "description": "Cria um novo orçamento (quote) no MármoreProart para o usuário autenticado. Salva os dados via Supabase respeitando RLS (owner_id = usuário logado).",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "client_name": {
              "type": "string",
              "minLength": 1,
              "description": "Nome do cliente."
            },
            "client_whatsapp": {
              "type": "string",
              "description": "WhatsApp do cliente (com DDD, ex: +5511999999999)."
            },
            "environment_type": {
              "type": "string",
              "description": "Tipo de ambiente (ex: cozinha, banheiro, área externa)."
            },
            "stone_type": {
              "type": "string",
              "description": "Tipo de pedra (ex: mármore, quartzo, quartzito)."
            },
            "estimated_value": {
              "type": "number",
              "minimum": 0,
              "description": "Valor estimado em reais."
            },
            "status": {
              "type": "string",
              "enum": [
                "aguardando",
                "aprovado",
                "recusado",
                "expirado"
              ],
              "description": "Status do orçamento. Padrão: aguardando."
            },
            "sent_date": {
              "type": "string",
              "description": "Data de envio no formato YYYY-MM-DD. Padrão: hoje."
            },
            "follow_up_date": {
              "type": "string",
              "description": "Data para follow-up no formato YYYY-MM-DD."
            },
            "observations": {
              "type": "string",
              "description": "Observações internas sobre o orçamento."
            }
          },
          "required": [
            "client_name"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
